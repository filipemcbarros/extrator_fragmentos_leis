      ]
    },
    {
      "tipo": "artigo",
      "numero": "14",
      "rotulo": "Art. 14",
      "caminho": "Art. 14",
      "texto": "As vagas provenientes da presente lei deverão ser preenchidas à razão de um têrço por ano, em data fixada pelo Regulamento de Promoções para os Oficiais da Aeronáutica.",
      "linha": 185,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 14, Parágrafo único",
          "texto": "Quando o número correspondente ao aumento não fôr múltiplo de três, o resto verificado será desdobrado em unidades que serão distribuídas no segundo e no terceiro têrço. O mesmo critério será adotado quando o aumento fôr menor que três.",
          "linha": 186
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "15",
      "rotulo": "Art. 15",
      "caminho": "Art. 15",
      "texto": "Os acessos aos diferentes postos dos diversos quadros constantes desta lei serão regulados por ato do Poder Executivo.",
      "linha": 187,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 15, Parágrafo único",
          "texto": "As condições de recrutamento, as escolas e os cursos de formação e aperfeiçoamento, referentes aos diversos quadros, serão regulados por ato do Poder Executivo.",
          "linha": 188
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "16",
      "rotulo": "Art. 16",
      "caminho": "Art. 16",
      "texto": "A designação das funções privativas dos diferentes postos dos quadros, de que tratam os arts. 1º, 2º, 3º, 4º, 5º, 6º, 7º, 8º, 9º, 10, 11, 12 e 13 será feita por ato do Poder Executivo.",
      "linha": 189
    },
    {
      "tipo": "artigo",
      "numero": "17",
      "rotulo": "Art. 17",
      "caminho": "Art. 17",
      "texto": "Esta lei entrará em vigor na data de sua publicação, revogadas as disposições em contrário.",
      "linha": 190
    },
    {
      "tipo": "artigo",
      "numero": "18",
      "rotulo": "Art. 18",
      "caminho": "Art. 18",
      "texto": "As despesas decorrentes da presente lei correrão por conta da dotações orçamentárias próprias.",
      "linha": 191
    }
