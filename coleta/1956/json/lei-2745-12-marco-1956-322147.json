    {
      "tipo": "artigo",
      "numero": "25",
      "rotulo": "Art. 25",
      "caminho": "Art. 25",
      "texto": "Dentro de 180 (cento e oitenta) dias elaborará o Poder Executivo o plano de classificação de cargos do serviço público.",
      "linha": 106
    },
    {
      "tipo": "artigo",
      "numero": "26",
