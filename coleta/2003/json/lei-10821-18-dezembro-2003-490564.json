        },
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 1º, Parágrafo único",
          "texto": "As importâncias pagas serão deduzidas de qualquer indenização que a União venha a desembolsar em razão do acidente referido no caput .",
          "linha": 24
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "2º",
      "rotulo": "Art. 2º",
      "caminho": "Art. 2º",
      "texto": "A indenização prevista nesta Lei será deferida aos dependentes na ordem de preferência estabelecida pela Lei nº 8.213, de 24 de julho de 1991.",
      "linha": 25
    },
    {
      "tipo": "artigo",
      "numero": "3º",
      "rotulo": "Art. 3º",
      "caminho": "Art. 3º",
      "texto": "A indenização a ser paga na forma do art. 1º, em parcela única, corresponderá ao produto do montante total do valor da remuneração fixa, percebida pelo servidor falecido, no mês anterior ao da ocorrência do óbito, pelo número de anos remanescentes até a data em que completaria 65 (sessenta e cinco) anos de vida.",
      "linha": 26,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "1º",
          "rotulo": "§ 1º",
          "caminho": "Art. 3º, § 1º",
          "texto": "Considera-se remuneração fixa, para os efeitos desta Lei, as seguintes rubricas:",
          "linha": 27,
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "rotulo": "I",
              "caminho": "Art. 3º, § 1º, I",
              "texto": "vencimento básico;",
              "linha": 28
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "rotulo": "II",
              "caminho": "Art. 3º, § 1º, II",
              "texto": "vantagem pessoal a título de adicional por tempo de serviço;",
              "linha": 29
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "rotulo": "III",
              "caminho": "Art. 3º, § 1º, III",
              "texto": "Gratificação de Desempenho de Atividade de Ciência e Tecnologia;",
              "linha": 30
            },
            {
              "tipo": "inciso",
              "numero": "IV",
              "rotulo": "IV",
              "caminho": "Art. 3º, § 1º, IV",
              "texto": "vantagem pecuniária individual; e",
              "linha": 31
            },
            {
              "tipo": "inciso",
              "numero": "V",
              "rotulo": "V",
              "caminho": "Art. 3º, § 1º, V",
              "texto": "vantagem pessoal decorrente de quintos ou décimos incorporados.",
              "linha": 32
            }
          ]
        },
        {
          "tipo": "paragrafo",
          "numero": "2º",
          "rotulo": "§ 2º",
          "caminho": "Art. 3º, § 2º",
          "texto": "Em nenhuma hipótese o valor da indenização será inferior a R$ 100.000,00 (cem mil reais).",
          "linha": 33
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "4º",
      "rotulo": "Art. 4º",
      "caminho": "Art. 4º",
      "texto": "Até completarem 24 (vinte e quatro) anos, os dependentes diretos dos trabalhadores de que trata esta Lei terão direito à bolsa-educação especial, a ser paga mensalmente mediante depósito em conta bancária vinculada.",
      "linha": 34,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "1º",
          "rotulo": "§ 1º",
          "caminho": "Art. 4º, § 1º",
          "texto": "O valor de que trata o caput deste artigo será de R$ 400,00 (quatrocentos reais) mensais, por dependente, devendo ser atualizado anualmente, sempre no mês de janeiro, adotando-se o índice legalmente estipulado para o reajuste das mensalidades escolares das instituições particulares de ensino.",
          "linha": 35
        },
        {
          "tipo": "paragrafo",
          "numero": "2º",
          "rotulo": "§ 2º",
          "caminho": "Art. 4º, § 2º",
          "texto": "O Ministério da Defesa regulamentará o disposto neste artigo em 30 (trinta) dias a contar da publicação desta Lei.",
          "linha": 36
        },
        {
          "tipo": "paragrafo",
          "numero": "3º",
          "rotulo": "§ 3º",
          "caminho": "Art. 4º, § 3º",
          "texto": "Caberá ao Ministério do Planejamento, Orçamento e Gestão inserir em programação orçamentária específica anual do Ministério da Defesa valor suficiente ao pagamento das despesas criadas por este artigo.",
          "linha": 37
        },
        {
          "tipo": "paragrafo",
          "numero": "4º",
          "rotulo": "§ 4º",
          "caminho": "Art. 4º, § 4º",
          "texto": "Os valores creditados nas contas vinculadas de que trata o caput poderão ser resgatados, mensalmente, pelo respectivo titular, se maior de idade, ou pelo respectivo responsável.",
          "linha": 38
        }
      ]
    },
