  "origem": "https://www2.camara.leg.br/legin/fed/lei/1950-1959/lei-3508-27-dezembro-1958-354057-publicacaooriginal-1-pl.html",
  "contagem": {
    "artigo": 18,
    "paragrafo": 5
  },
  "dispositivos": [
    {
      "tipo": "artigo",
      "numero": "1º",
      "rotulo": "Art. 1º",
      "caminho": "Art. 1º",
      "texto": "Ficam alterados no têrmos desta lei e das tabelas anexas, o Quadro da Secretaria do Tribunal de Justiça do Distrito Federal e o da Secretaria da Corregedoria da Justiça do Distrito Federal.",
      "linha": 2,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 1º, Parágrafo único",
          "texto": "Compete ao Presidente do Tribunal determinar a apostila dos títulos de nomeação, dos funcionários em face de sua nova situação decorrente da presente lei.",
          "linha": 3
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "2º",
      "rotulo": "Art. 2º",
      "caminho": "Art. 2º",
      "texto": "A carreira de Oficial Judiciário dos Quadros das Secretarias do Tribunal e da Corregedoria da Justiça do Distrito Federal, escalonada de M e O passa a ter a estrutura constante das Tabelas B e D, anexas à presente lei.",
      "linha": 4,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 2º, Parágrafo único",
          "texto": "Os atuais ocupantes efetivos das classes N e M da referida carreira serão classificados, em cada um dos citados quadros, na classe O indo os das classes L e K para a classe N e os da classe J para a classe M (VETADO).",
          "linha": 5
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "3º",
      "rotulo": "Art. 3º",
      "caminho": "Art. 3º",
      "texto": "As carreiras de Auxiliar Judiciário e Dactilógrafo dos aludidos quadros ficam fundidas na de Auxiliar Judiciário, escalonada de H a L e com a estrutura constante das Tabelas B e D desta lei.",
      "linha": 6,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 3º, Parágrafo único",
          "texto": "Os atuais ocupantes efetivos das classes J e I das referidas carreiras passarão a ocupar, nos quadros a que pertencerem a classe L da nova carreira, indo os da classes H - G e F para as classes K - J e I, respectivamente.",
          "linha": 7
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "4º",
      "rotulo": "Art. 4º",
      "caminho": "Art. 4º",
      "texto": "Aos integrantes da carreira de Auxiliar Judiciário cabe precìpuamente, a execução dos serviços de dactilografia.",
      "linha": 8
    },
    {
      "tipo": "artigo",
      "numero": "5º",
      "rotulo": "Art. 5º",
      "caminho": "Art. 5º",
      "texto": "Os ocupantes da classe final da carreira de Auxiliar Judiciário terão acesso à classe inicial da carreira de Oficial Judiciário (VETADO).",
      "linha": 9
    },
    {
      "tipo": "artigo",
      "numero": "6º",
      "rotulo": "Art. 6º",
      "caminho": "Art. 6º",
      "texto": "As carreiras de Artífice, Ascensorista, Guarda Judiciário e Auxiliar de Portaria do quadro da Secretaria do Tribunal, que passam a ter estrutura constante da Tabela B, ficam escalonados nas classes H a L, G a J, G e K, e G a K, respectivamente.",
      "linha": 10
    },
    {
      "tipo": "artigo",
      "numero": "7º",
      "rotulo": "Art. 7º",
      "caminho": "Art. 7º",
      "texto": "Aos Auxiliares de Portaria, além dos serviços gerais de zeladoria e portaria, incumbe, de acôrdo com as instruções que forem baixadas pelo Presidente do Tribunal, auxiliar os serviços de limpeza e conservação.",
      "linha": 11
    },
    {
      "tipo": "artigo",
      "numero": "8º",
      "rotulo": "Art. 8º",
      "caminho": "Art. 8º",
      "texto": "Ficam criados no Quadro da Secretaria do Tribunal os cargos isolados de provimento efetivo de Chefe de Seção de Comunicações, símbolo PJ-2 (um), de Revisor, padrão O (um), de Auxiliar de Bibliotecário, padrão L (um), dois de Motorista, padrão J, e 25 (vinte e cinco) de Servente, padrão G, bem como uma função gratificada de Secretário do Diretor Geral, FG-4, nove de Encarregado de Turma, FG-5, uma de Chefe de Portaria, FG-4, e uma de Chefe de Zeladoria, FG-4.",
      "linha": 12
    },
    {
      "tipo": "artigo",
      "numero": "9º",
      "rotulo": "Art. 9º",
      "caminho": "Art. 9º",
      "texto": "Ficam criados no Quadro da Corregedoria os seguintes cargos isolados de provimento efetivo: dois de Chefe de Seção, PJ-3, um Servente H, sete de Servente, padrão G, dez de Assistente Social, padrão J, e dois de Motorista, padrão J.",
      "linha": 13,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 9º, Parágrafo único",
          "texto": "Serão aproveitados nos cargos de Assistente Social, Motorista e Servente, a que se refere êste artigo, os atuais extranumerários ocupantes das referidas funções, no Quadro da Corregedoria.",
          "linha": 14
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "10",
      "rotulo": "Art. 10",
      "caminho": "Art. 10",
      "texto": "Os cargos isolados de provimento efetivo dos Quadros das Secretarias do Tribunal e da Corregedoria passam a ter os símbolos e padrões de vencimentos constantes das Tabelas A e C, anexas à presente lei.",
      "linha": 15
    },
    {
      "tipo": "artigo",
      "numero": "11",
      "rotulo": "Art. 11",
      "caminho": "Art. 11",
      "texto": "Ficam extintos, quando vagarem, um cargo isolado de Ajudante de Motorista, padrão G, e um de Protocolista, padrão M, assim como um de Escriturário, um de Auxiliar de Arquivista, trinta e seis de Auxiliar de Escritório e cinco de Servente, da série funcional de Extranumerário, e ainda dezesseis de Servente contratado, todos da Secretaria do Tribunal de Justiça.",
      "linha": 16
    },
    {
      "tipo": "artigo",
      "numero": "12",
      "rotulo": "Art. 12",
      "caminho": "Art. 12",
      "texto": "Ficam também extintas na Secretaria da Corregedoria da Justiça, logo que vagarem, duas funções gratificadas de Chefe de Seção FG-3, cinco de Inspetor, seis de Escriturário, sete de Auxiliar de Escritório, cinco de Servente, dez de Assistente Social e um de Motorista, todos da série funcional de Extranumerário.",
      "linha": 17
    },
    {
      "tipo": "artigo",
      "numero": "13",
      "rotulo": "Art. 13",
      "caminho": "Art. 13",
      "texto": "O Revisor, cujo cargo é criado por esta lei, terá exercício na Seção de Comunicações, incumbindo-lhe a supervisão da Turma de Conferência e Registro de Acórdãos.",
      "linha": 18
    },
    {
      "tipo": "artigo",
      "numero": "14",
      "rotulo": "Art. 14",
      "caminho": "Art. 14",
      "texto": "É vedado ao Tribunal de Justiça do Distrito Federal contratar novos servidores ou admitir, a qualquer título, extranumerários para a sua Secretaria e Serviços Auxiliares, inclusive para a Corregedoria.",
      "linha": 19
    },
    {
      "tipo": "artigo",
      "numero": "15",
      "rotulo": "Art. 15",
      "caminho": "Art. 15",
      "texto": "Os cargos isolados serão providos pelo Tribunal por proposta de seu Presidente, observadas as indicações do Corregedor quanto aos cargos da Corregedoria, dando-se, todavia, preferência aos servidores do Tribunal ou da Corregedoria, sempre que, a critério do Tribunal, satisfaçam os requisitos de merecimento e especialização.",
      "linha": 20,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 15, Parágrafo único",
          "texto": "Cabe ao Presidente do Tribunal prover livremente as funções gratificadas.",
          "linha": 21
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "16",
      "rotulo": "Art. 16",
      "caminho": "Art. 16",
      "texto": "Na nomeação, promoção, licença, exoneração, demissão, readmissão, readaptação e aposentadoria dos funcionários da Secretaria do Tribunal e da Corregedoria da Justiça do Distrito Federal aplicam-se, no que couberem, as normas do Estatuto dos Funcionários Públicos Civis de União (Lei nº 1.711, de 28 de outubro de 1952).",
      "linha": 22
    },
    {
      "tipo": "artigo",
      "numero": "17",
      "rotulo": "Art. 17",
      "caminho": "Art. 17",
      "texto": "Para atender, no corrente exercício ao aumento de despesas decorrente desta lei, é o Poder Executivo autorizado a abrir ao Poder Judiciário - Tribunal de Justiça do Distrito Federal - o crédito especial de Cr$ 8.000.000,00 (oito milhões de cruzeiros).",
      "linha": 23
    },
    {
      "tipo": "artigo",
      "numero": "18",
      "rotulo": "Art. 18",
      "caminho": "Art. 18",
      "texto": "Esta lei entrará em vigor na data de sua publicação, revogadas as disposições em contrário.",
      "linha": 24
    }
  ],
