          "linha": 170
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "9º",
      "rotulo": "Art. 9º",
      "caminho": "Art. 9º",
      "texto": "O Governador do Distrito Federal, mediante Decreto:",
