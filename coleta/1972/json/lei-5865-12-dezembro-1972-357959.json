        {
          "tipo": "inciso",
          "numero": "I",
          "rotulo": "I",
          "caminho": "Art. 7º, I",
          "texto": "utilizar o excesso de arrecadação apurada de acordo com o § 3º, do Art. 48, da Lei nº 4.320, de 17 de março de 1964; e",
          "linha": 165
        },
        {
          "tipo": "inciso",
          "numero": "II",
          "rotulo": "II",
          "caminho": "Art. 7º, II",
          "texto": "anular, total ou parcialmente, dotações orçamentárias, na forma prevista no item III, do § 1º, da Lei nº 4.320, de 17 de março de 1964.",
          "linha": 166
        }
      ]
    },
    {
