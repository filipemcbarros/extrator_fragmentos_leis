        }
      ]
    },
    {
      "tipo": "capitulo",
      "numero": "X",
      "rotulo": "CAPITULO X",
      "caminho": "CAPITULO X",
      "texto": "",
      "rubrica": "DAS INFRAÇÕES, PENALIDADES E RECURSOS",
      "linha": 66,
      "filhos": [
        {
          "tipo": "artigo",
          "numero": "38",
          "rotulo": "Art. 38",
          "caminho": "CAPITULO X, Art. 38",
          "texto": "A falta do competente registro, bem como do pagamento da anuidade, caracterizará o exercício ilegal da profissão de Bibliotecário.",
          "linha": 68
        },
        {
          "tipo": "artigo",
          "numero": "39",
          "rotulo": "Art. 39",
          "caminho": "CAPITULO X, Art. 39",
          "texto": "Constituem infrações disciplinares:",
          "linha": 69,
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "rotulo": "I",
              "caminho": "CAPITULO X, Art. 39, I",
              "texto": "exercer a profissão quando impedido de fazê-lo ou facilitar, por qualquer modo, o seu exercício a não registrados;",
              "linha": 70
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "rotulo": "II",
              "caminho": "CAPITULO X, Art. 39, II",
              "texto": "praticar, no exercício profissional, ato que a lei defina como crime ou contravenção penal;",
              "linha": 71
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "rotulo": "III",
              "caminho": "CAPITULO X, Art. 39, III",
              "texto": "não cumprir, no prazo estipulado, determinação emanada do Conselho Regional em matéria de competência deste, após regularmente notificado;",
              "linha": 72
            },
            {
              "tipo": "inciso",
              "numero": "IV",
              "rotulo": "IV",
              "caminho": "CAPITULO X, Art. 39, IV",
              "texto": "deixar de pagar ao Conselho Regional, nos prazos previstos, as contribuições a que está obrigado;",
              "linha": 73
            },
            {
              "tipo": "inciso",
              "numero": "V",
              "rotulo": "V",
              "caminho": "CAPITULO X, Art. 39, V",
              "texto": "faltar a qualquer dever profissional previsto nesta Lei;",
              "linha": 74
            },
            {
              "tipo": "inciso",
              "numero": "VI",
              "rotulo": "VI",
              "caminho": "CAPITULO X, Art. 39, VI",
              "texto": "transgredir preceitos do Código de Ética Profissional.",
              "linha": 75
            },
            {
              "tipo": "paragrafo",
              "numero": "único",
              "rotulo": "Parágrafo único",
              "caminho": "CAPITULO X, Art. 39, Parágrafo único",
              "texto": "As infrações serão apuradas levando-se em conta a natureza do ato e as circunstâncias de cada caso.",
              "linha": 76
            }
          ]
        },
        {
          "tipo": "artigo",
          "numero": "40",
          "rotulo": "Art. 40",
          "caminho": "CAPITULO X, Art. 40",
          "texto": "As penas disciplinares, consideradas a gravidade da infração cometida e a reincidência das mesmas, consistem em:",
          "linha": 77,
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "rotulo": "I",
              "caminho": "CAPITULO X, Art. 40, I",
              "texto": "multa de uma a cinqüenta vezes o valor atualizado da anuidade;",
              "linha": 78
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "rotulo": "II",
              "caminho": "CAPITULO X, Art. 40, II",
              "texto": "advertência reservada;",
              "linha": 79
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "rotulo": "III",
              "caminho": "CAPITULO X, Art. 40, III",
              "texto": "censura pública;",
              "linha": 80
            },
            {
              "tipo": "inciso",
              "numero": "IV",
              "rotulo": "IV",
              "caminho": "CAPITULO X, Art. 40, IV",
              "texto": "suspensão do exercício profissional de até três anos;",
              "linha": 81
            },
            {
              "tipo": "inciso",
              "numero": "V",
              "rotulo": "V",
              "caminho": "CAPITULO X, Art. 40, V",
              "texto": "cassação do exercício profissional com a apreensão da carteira profissional.",
              "linha": 82
            },
            {
              "tipo": "paragrafo",
              "numero": "1º",
              "rotulo": "§ 1º",
              "caminho": "CAPITULO X, Art. 40, § 1º",
              "texto": "A pena de multa poderá ser combinada com qualquer das penalidades enumeradas neste artigo, podendo ser aplicada em dobro em caso de reincidência da mesma infração.",
              "linha": 83
            },
            {
              "tipo": "paragrafo",
              "numero": "2º",
              "rotulo": "§ 2º",
              "caminho": "CAPITULO X, Art. 40, § 2º",
              "texto": "A falta de pagamento da multa prevista neste Capítulo no prazo estipulado determinará a suspensão do exercício profissional, sem prejuízo da cobrança por via executiva.",
              "linha": 84
            },
            {
              "tipo": "paragrafo",
              "numero": "3º",
              "rotulo": "§ 3º",
              "caminho": "CAPITULO X, Art. 40, § 3º",
              "texto": "A suspensão por falta de pagamento de anuidades, taxas e multas somente cessará com o recolhimento da dívida, podendo estender-se a até três anos, decorridos os quais o profissional terá, automaticamente, cancelado seu registro, se não resgatar o débito, sem prejuízo da cobrança executiva.",
              "linha": 85
            },
            {
              "tipo": "paragrafo",
              "numero": "4º",
              "rotulo": "§ 4º",
              "caminho": "CAPITULO X, Art. 40, § 4º",
              "texto": "A pena de cassação do exercício profissional acarretará ao infrator a perda do direito de exercer a profissão, em todo o território nacional, com apreensão da carteira de identidade profissional.",
              "linha": 86
            },
            {
              "tipo": "paragrafo",
              "numero": "5º",
              "rotulo": "§ 5º",
              "caminho": "CAPITULO X, Art. 40, § 5º",
              "texto": "Ao infrator suspenso por débitos será admitida a reabilitação profissional mediante novo registro, satisfeitos, além das anuidades em débito, as multas e demais emolumentos e taxas cabíveis.",
              "linha": 87
            }
          ]
        },
        {
          "tipo": "artigo",
          "numero": "41",
          "rotulo": "Art. 41",
          "caminho": "CAPITULO X, Art. 41",
          "texto": "(VETADO)",
          "linha": 88
        },
        {
          "tipo": "artigo",
