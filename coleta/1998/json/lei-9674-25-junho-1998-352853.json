    {
      "tipo": "capitulo",
      "numero": "VI",
      "rotulo": "CAPITULO VI",
      "caminho": "CAPITULO VI",
      "texto": "",
      "rubrica": "DO REGISTRO DE BIBLIOTECÁRIOS",
      "linha": 44,
      "filhos": [
        {
          "tipo": "artigo",
          "numero": "29",
          "rotulo": "Art. 29",
          "caminho": "CAPITULO VI, Art. 29",
          "texto": "O exercício da função de Bibliotecário é privativo dos bibliotecários inscritos nos quadros do Conselho Regional da respectiva jurisdição, nos termos desta Lei.",
          "linha": 46,
          "filhos": [
            {
              "tipo": "paragrafo",
              "numero": "1º",
              "rotulo": "§ 1º",
              "caminho": "CAPITULO VI, Art. 29, § 1º",
              "texto": "É obrigatória a citação do número de registros no Conselho Regional, em todos os documentos de responsabilidade profissional.",
              "linha": 47
            },
            {
              "tipo": "paragrafo",
              "numero": "2º",
              "rotulo": "§ 2º",
              "caminho": "CAPITULO VI, Art. 29, § 2º",
              "texto": "(VETADO)",
              "linha": 48
            }
          ]
        },
        {
          "tipo": "artigo",
          "numero": "30",
          "rotulo": "Art. 30",
          "caminho": "CAPITULO VI, Art. 30",
          "texto": "Ao profissional devidamente registrado no Conselho Regional serão fornecidas a carteira de identidade profissional e a cédula de identidade de Bibliotecário, que terão fé pública, nos termos da Lei.",
          "linha": 49
        }
      ]
    },
    {
