  "dispositivos": [
    {
      "tipo": "capitulo",
      "numero": "I",
      "rotulo": "CAPITULO I",
      "caminho": "CAPITULO I",
      "texto": "",
      "rubrica": "DA PROFISSÃO DE BIBLIOTECÁRIO",
      "linha": 2,
      "filhos": [
        {
          "tipo": "artigo",
          "numero": "1º",
          "rotulo": "Art. 1º",
          "caminho": "CAPITULO I, Art. 1º",
          "texto": "O exercício da Profissão de Bibliotecário, em todo o território nacional, somente é permitido quando atendidas as qualificações estabelecidas nesta Lei.",
          "linha": 4,
          "filhos": [
            {
              "tipo": "paragrafo",
              "numero": "único",
              "rotulo": "Parágrafo único",
              "caminho": "CAPITULO I, Art. 1º, Parágrafo único",
              "texto": "A designação \"Bibliotecário\", incluída no Quadro das Profissões Liberais, Grupo 19, da Consolidação das Leis do Trabalho, é privativa dos Bacharéis em Biblioteconomia.",
              "linha": 5
            }
          ]
        },
        {
          "tipo": "artigo",
          "numero": "2º",
          "rotulo": "Art. 2º",
          "caminho": "CAPITULO I, Art. 2º",
          "texto": "(VETADO)",
          "linha": 6
        },
        {
          "tipo": "artigo",
          "numero": "3º",
          "rotulo": "Art. 3º",
          "caminho": "CAPITULO I, Art. 3º",
          "texto": "O exercício da profissão de Bibliotecário é privativo:",
          "linha": 7,
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "rotulo": "I",
              "caminho": "CAPITULO I, Art. 3º, I",
              "texto": "dos portadores de diploma de Bacharel em Biblioteconomia, expedido por instituições de ensino superior oficialmente reconhecidas, registradas nos órgãos competentes, de acordo com a legislação em vigor;",
              "linha": 8
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "rotulo": "II",
              "caminho": "CAPITULO I, Art. 3º, II",
              "texto": "dos portadores de diploma de graduação em Biblioteconomia, conferido por instituições estrangeiras de ensino superior, reconhecidas pelas leis do país de origem, e revalidados no Brasil, de acordo com a legislação vigente;",
              "linha": 9
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "rotulo": "III",
              "caminho": "CAPITULO I, Art. 3º, III",
              "texto": "dos amparados pela Lei nº 7.504, de 2 de julho de 1986.",
              "linha": 10
            }
          ]
        }
      ]
    },
    {
      "tipo": "capitulo",
      "numero": "II",
      "rotulo": "CAPITULO II",
      "caminho": "CAPITULO II",
      "texto": "",
