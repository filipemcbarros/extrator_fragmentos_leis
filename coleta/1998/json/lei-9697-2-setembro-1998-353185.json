    {
      "tipo": "artigo",
      "numero": "3º",
      "rotulo": "Art. 3º",
      "caminho": "Art. 3º",
      "texto": "São criados, na Segunda Região da Justiça do Trabalho, dois cargos de Juiz-Presidente de Junta de Conciliação e Julgamento, dois cargos de Juiz Classista representante dos trabalhadores e dois cargos de Juiz Classista representante dos empregadores.",
      "linha": 36,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 3º, Parágrafo único",
          "texto": "Para cada cargo de Juiz Classista haverá um suplente.",
          "linha": 37
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "4º",
      "rotulo": "Art. 4º",
      "caminho": "Art. 4º",
      "texto": "As Juntas de Conciliação e Julgamento criadas por esta Lei serão instaladas e os respectivos cargos providos, gradativamente, à medida que ocorrer a disponibilidade de recursos financeiros.",
      "linha": 38
    },
    {
      "tipo": "artigo",
      "numero": "5º",
      "rotulo": "Art. 5º",
      "caminho": "Art. 5º",
      "texto": "A competência territorial das Juntas de Conciliação e Julgamento atualmente existentes somente será alterada na data de instalação dos novos órgãos jurisdicionais criados por esta Lei.",
      "linha": 39
    },
    {
      "tipo": "artigo",
      "numero": "6º",
      "rotulo": "Art. 6º",
      "caminho": "Art. 6º",
      "texto": "No caso de emancipação de distrito, é mantida a jurisdição da mesma Junta de Conciliação e Julgamento sobre a área territorial do novo Município.",
      "linha": 40
    },
    {
      "tipo": "artigo",
      "numero": "7º",
      "rotulo": "Art. 7º",
      "caminho": "Art. 7º",
      "texto": "São criados no Quadro de Pessoal da Secretaria do Tribunal Regional do Trabalho da Segunda Região os cargos de provimento efetivo e as funções comissionadas constantes dos Anexos I e II desta Lei.",
      "linha": 41,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "1º",
          "rotulo": "§ 1º",
          "caminho": "Art. 7º, § 1º",
          "texto": "As funções comissionadas de que trata esta Lei serão providas exclusivamente por servidores do Quadro de Pessoal da Secretaria do Tribunal Regional do Trabalho da Segunda Região.",
          "linha": 42
        },
        {
          "tipo": "paragrafo",
          "numero": "2º",
          "rotulo": "§ 2º",
          "caminho": "Art. 7º, § 2º",
          "texto": "O Tribunal Regional do Trabalho da Segunda Região especificará as áreas de atividade e/ou especialidade dos cargos efetivos criados.",
          "linha": 43
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "8º",
      "rotulo": "Art. 8º",
      "caminho": "Art. 8º",
      "texto": "As despesas decorrentes da execução desta Lei correrão à conta de recursos próprios, consignados ao Tribunal Regional do Trabalho da Segunda Região.",
      "linha": 44
    },
    {
      "tipo": "artigo",
