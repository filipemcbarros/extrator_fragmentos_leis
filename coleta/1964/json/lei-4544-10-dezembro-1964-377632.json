      "numero": "7º",
      "rotulo": "Art. 7º",
      "caminho": "Art. 7º",
      "texto": "Esta Lei entrará em vigor a 1º de janeiro de 1965, revogadas as disposições em contrário.",
      "linha": 43
    }
