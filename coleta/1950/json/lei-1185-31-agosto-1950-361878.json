    {
      "tipo": "artigo",
      "numero": "2º",
      "rotulo": "Art. 2º",
      "caminho": "Art. 2º",
      "texto": "Sòmente a partir de 1 de janeiro de 1952 poderão ser preenchidas 100 (cem) vagas de Capitães Aviadores, 100 (cem) vagas de Primeiros Tenentes Aviadores, 4 (quatro) vagas de Majores Especialistas em Aviação, 1 (uma) vaga de Major Especialista em Armamento, 2 (duas) vagas de Majores Especialistas em Comunicações, 1 (uma) vaga de Major Especialista em Fotografia, 1 (uma) vaga de Major Especialista em Meteorologia, 1 (uma) vaga de Major Especialista em Contrôle de Tráfego Aéreo e 6 (seis) vagas de Capitães Especialistas em Contrôle de Tráfego Aéreo.",
      "linha": 127
    },
    {
      "tipo": "artigo",
      "numero": "3º",
      "rotulo": "Art. 3º",
      "caminho": "Art. 3º",
      "texto": "As funções de Comandante das 2ª, 3ª, 4ª e 5ª Zonas Aéreas, Inspetor Geral do Estado-Maior, Diretor Geral do Ensino e Diretor Geral do Material serão privativas do pôsto de Major-Brigadeiro.",
      "linha": 128,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "1º",
          "rotulo": "§ 1º",
          "caminho": "Art. 3º, § 1º",
          "texto": "A Chefia do Estado-Maior da Aeronáutica e a Direção Geral de Rotas Aéreas serão exercidas por Oficial-General do pôsto de Tenente-Brigadeiro.",
          "linha": 129
        },
        {
          "tipo": "paragrafo",
          "numero": "2º",
          "rotulo": "§ 2º",
          "caminho": "Art. 3º, § 2º",
          "texto": "A designação das demais funções privativas dos diferentes postos dos quadros, de que trata o art. 1º, será feita em decreto baixado pelo Presidente da República, atendidas as possibilidades orçamentárias e a Lei de Fixação das Fôrças Armadas.",
          "linha": 130
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "4º",
      "rotulo": "Art. 4º",
      "caminho": "Art. 4º",
      "texto": "Passarão compulsòriamente para o Quadro Complementar de Aviadores os atuais oficiais do Quadro de Oficiais Auxiliares, com os mesmos direitos, deveres e vantagens.",
      "linha": 131,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 4º, Parágrafo único",
          "texto": "É aplicada ao Quadro Complementar de aviadores a legislação ora existente para o Quadro de Oficiais Auxiliares.",
          "linha": 132
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "5º",
      "rotulo": "Art. 5º",
      "caminho": "Art. 5º",
      "texto": "Passarão compulsòriamente para os Quadros de Oficiais Especialistas em Avião, Armamento, Comunicações e Fotografia, respectivamente, e com direitos e vantagens do Quadro de origem, os atuais Oficiais e Aspirantes a Oficial Mecânico de Avião, Armamento, Rádio e Fotógrafo, possuidores do curso de Oficial Mecânico.",
      "linha": 133,
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "único",
          "rotulo": "Parágrafo único",
          "caminho": "Art. 5º, Parágrafo único",
          "texto": "VETADO.",
          "linha": 134
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "6º",
      "rotulo": "Art. 6º",
      "caminho": "Art. 6º",
      "texto": "Fica em extinção o Quadro de Oficiais Mecânicos, criado pelo Decreto-lei nº 3.810, de 10 de novembro de 1941... VETADO ...",
      "linha": 135
    },
    {
      "tipo": "artigo",
      "numero": "7º",
      "rotulo": "Art. 7º",
      "caminho": "Art. 7º",
      "texto": "O Poder Executivo regulamentará o acesso ao pôsto de Major do Quadro de Infantaria de Guarda.",
      "linha": 136
    },
    {
      "tipo": "artigo",
      "numero": "8º",
      "rotulo": "Art. 8º",
      "caminho": "Art. 8º",
      "texto": "O ingresso em todos os Quadros de Oficiais Especialistas se fará após a conclusão com aproveitamento do Curso de Oficiais Especialistas (C. O. E.), para o qual o Poder Executivo dará regulamentação concordante com os dispositivos desta Lei.",
      "linha": 137
    },
    {
      "tipo": "artigo",
      "numero": "9º",
      "rotulo": "Art. 9º",
      "caminho": "Art. 9º",
      "texto": "As despesas decorrentes da presente Lei correrão à conta das dotações orçamentárias próprias.",
