              "numero": "2º",
              "rotulo": "§ 2º",
              "caminho": "CAPITULO III, Art. 24, § 2º",
              "texto": "No caso do inciso II do caput deste artigo, o ingresso deverá ser reportado à Funai, informados seus objetivos e sua duração.",
              "linha": 75
            },
            {
              "tipo": "paragrafo",
              "numero": "3º",
              "rotulo": "§ 3º",
              "caminho": "CAPITULO III, Art. 24, § 3º",
              "texto": "(VETADO).",
              "linha": 76
            }
          ]
        },
        {
