              "rotulo": "Art. 5º",
              "caminho": "CAPITULO II, SECAO II, Art. 5º",
              "texto": "(VETADO).",
              "linha": 34,
              "filhos": [
                {
                  "tipo": "paragrafo",
                  "numero": "único",
                  "rotulo": "Parágrafo único",
                  "caminho": "CAPITULO II, SECAO II, Art. 5º, Parágrafo único",
                  "texto": "É assegurado aos entes federativos o direito de participação efetiva no processo administrativo de demarcação de terras tradicionalmente ocupadas pelos indígenas.",
                  "linha": 35
                }
              ]
            },
