          "filhos": [
            {
              "tipo": "artigo",
              "numero": "16",
              "rotulo": "Art. 16",
              "caminho": "CAPITULO II, SECAO III, Art. 16",
              "texto": "São áreas indígenas reservadas as destinadas pela União à posse e à ocupação por comunidades indígenas, de forma a garantir sua subsistência digna e a preservação de sua cultura.",
              "linha": 48,
              "filhos": [
                {
                  "tipo": "paragrafo",
                  "numero": "1º",
                  "rotulo": "§ 1º",
                  "caminho": "CAPITULO II, SECAO III, Art. 16, § 1º",
                  "texto": "As áreas indígenas reservadas poderão ser formadas por:",
                  "linha": 49,
                  "filhos": [
                    {
                      "tipo": "inciso",
                      "numero": "I",
                      "rotulo": "I",
                      "caminho": "CAPITULO II, SECAO III, Art. 16, § 1º, I",
                      "texto": "terras devolutas da União discriminadas para essa finalidade;",
                      "linha": 50
                    },
                    {
                      "tipo": "inciso",
                      "numero": "II",
                      "rotulo": "II",
                      "caminho": "CAPITULO II, SECAO III, Art. 16, § 1º, II",
                      "texto": "áreas públicas pertencentes à União;",
                      "linha": 51
                    },
                    {
                      "tipo": "inciso",
                      "numero": "III",
                      "rotulo": "III",
                      "caminho": "CAPITULO II, SECAO III, Art. 16, § 1º, III",
                      "texto": "áreas particulares desapropriadas por interesse social.",
                      "linha": 52
                    }
                  ]
                },
                {
                  "tipo": "paragrafo",
                  "numero": "2º",
                  "rotulo": "§ 2º",
                  "caminho": "CAPITULO II, SECAO III, Art. 16, § 2º",
                  "texto": "As reservas, os parques e as colônias agrícolas indígenas constituídos nos termos da Lei nº 6.001, de 19 dezembro de 1973, serão considerados áreas indígenas reservadas nos moldes desta Lei.",
                  "linha": 53
                },
                {
                  "tipo": "paragrafo",
                  "numero": "3º",
                  "rotulo": "§ 3º",
                  "caminho": "CAPITULO II, SECAO III, Art. 16, § 3º",
                  "texto": "As áreas indígenas reservadas são de propriedade da União e a sua gestão fica a cargo da comunidade indígena, sob a supervisão da Funai.",
                  "linha": 54
                },
                {
                  "tipo": "paragrafo",
                  "numero": "4º",
                  "rotulo": "§ 4º",
                  "caminho": "CAPITULO II, SECAO III, Art. 16, § 4º",
                  "texto": "(VETADO).",
                  "linha": 55
                }
              ]
            },
            {
              "tipo": "artigo",
              "numero": "17",
              "rotulo": "Art. 17",
              "caminho": "CAPITULO II, SECAO III, Art. 17",
              "texto": "Aplica-se às terras indígenas reservadas o mesmo regime jurídico de uso e gozo adotado para terras indígenas tradicionalmente ocupadas, nos moldes do Capítulo III desta Lei.",
              "linha": 56
            }
          ]
        },
