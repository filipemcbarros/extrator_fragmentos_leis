                {
                  "tipo": "paragrafo",
                  "numero": "5º",
                  "rotulo": "§ 5º",
                  "caminho": "CAPITULO II, SECAO II, Art. 4º, § 5º",
                  "texto": "O procedimento demarcatório será público e seus atos decisórios serão amplamente divulgados e disponibilizados para consulta em meio eletrônico.",
                  "linha": 30
                },
                {
                  "tipo": "paragrafo",
                  "numero": "6º",
                  "rotulo": "§ 6º",
                  "caminho": "CAPITULO II, SECAO II, Art. 4º, § 6º",
                  "texto": "É facultado a qualquer cidadão o acesso a todas as informações relativas à demarcação das terras indígenas, notadamente quanto aos estudos, aos laudos, às suas conclusões e fundamentação, ressalvado o sigilo referente a dados pessoais, nos termos da Lei nº 13.709, de 14 de agosto de 2018 (Lei Geral de Proteção de Dados Pessoais).",
                  "linha": 31
                },
                {
                  "tipo": "paragrafo",
                  "numero": "7º",
                  "rotulo": "§ 7º",
                  "caminho": "CAPITULO II, SECAO II, Art. 4º, § 7º",
                  "texto": "(VETADO).",
                  "linha": 32
                },
                {
                  "tipo": "paragrafo",
                  "numero": "8º",
                  "rotulo": "§ 8º",
                  "caminho": "CAPITULO II, SECAO II, Art. 4º, § 8º",
                  "texto": "É assegurada às partes interessadas a tradução da linguagem oral ou escrita, por tradutor nomeado pela Fundação Nacional dos Povos Indígenas (Funai), da língua indígena própria para o português, ou do português para a língua indígena própria, nos casos em que a comunidade indígena não domine a língua portuguesa.",
                  "linha": 33
                }
              ]
            },
