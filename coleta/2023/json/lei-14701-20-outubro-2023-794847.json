          "texto": "(VETADO).",
          "linha": 65
        },
        {
          "tipo": "artigo",
          "numero": "22",
          "rotulo": "Art. 22",
          "caminho": "CAPITULO III, Art. 22",
          "texto": "(VETADO).",
          "linha": 66
        },
        {
          "tipo": "artigo",
          "numero": "23",
          "rotulo": "Art. 23",
          "caminho": "CAPITULO III, Art. 23",
          "texto": "(VETADO).",
          "linha": 67
        },
        {
          "tipo": "artigo",
          "numero": "24",
          "rotulo": "Art. 24",
          "caminho": "CAPITULO III, Art. 24",
          "texto": "O ingresso de não indígenas em áreas indígenas poderá ser feito:",
          "linha": 68,
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "rotulo": "I",
              "caminho": "CAPITULO III, Art. 24, I",
              "texto": "por particulares autorizados pela comunidade indígena;",
              "linha": 69
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "rotulo": "II",
              "caminho": "CAPITULO III, Art. 24, II",
              "texto": "por agentes públicos justificadamente a serviço de um dos entes federativos;",
              "linha": 70
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "rotulo": "III",
              "caminho": "CAPITULO III, Art. 24, III",
              "texto": "pelos responsáveis pela prestação dos serviços públicos ou pela realização, manutenção ou instalação de obras e equipamentos públicos;",
              "linha": 71
            },
            {
              "tipo": "inciso",
              "numero": "IV",
              "rotulo": "IV",
              "caminho": "CAPITULO III, Art. 24, IV",
              "texto": "por pesquisadores autorizados pela Funai e pela comunidade indígena;",
