            },
            {
              "tipo": "inciso",
              "numero": "V",
              "rotulo": "V",
              "caminho": "CAPITULO I, Art. 2º, V",
              "texto": "a imprescritibilidade, a inalienabilidade e a indisponibilidade dos direitos indígenas.",
