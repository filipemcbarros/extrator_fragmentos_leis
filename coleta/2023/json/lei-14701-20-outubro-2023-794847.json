          "linha": 63,
          "filhos": [
            {
              "tipo": "paragrafo",
              "numero": "único",
              "rotulo": "Parágrafo único",
              "caminho": "CAPITULO III, Art. 20, Parágrafo único",
              "texto": "(VETADO).",
              "linha": 64
