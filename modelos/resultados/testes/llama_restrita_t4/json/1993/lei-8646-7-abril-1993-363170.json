                      "rubrica": "DA COMPOSIÇÃO DO CONSELHO MONETÁRIO NACIONAL",
                      "texto": "",
                      "filhos": [
                        {
                          "tipo": "subsecao",
                          "numero": "",
                          "rubrica": "DA COMPOSIÇÃO DO CONSELHO MONETÁRIO NACIONAL",
                          "texto": "",
                          "filhos": [
                            {
                              "tipo": "artigo",
                              "numero": "1º",
                              "texto": "O Conselho Monetário Nacional será integrado pelos seguintes membros:",
                              "filhos": [
                                {
                                  "tipo": "inciso",
                                  "numero": "I",
                                  "texto": "Ministro de Estado da Fazenda, na qualidade de Presidente;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "II",
                                  "texto": "Ministro de Estado Chefe da Secretaria do Planejamento, Orçamento e Coordenação da Presidência da República, na qualidade de Vice-Presidente;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "III",
                                  "texto": "Ministro de Estado da Agricultura, do Abastecimento e da Reforma Agrária;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "IV",
                                  "texto": "Ministro de Estado da Indústria, do Comércio e do Turismo;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "V",
                                  "texto": "Ministro de Estado do Trabalho;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "VI",
                                  "texto": "Ministro de Estado da Previdência Social;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "VII",
                                  "texto": "Presidente do Banco Central do Brasil;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "VIII",
                                  "texto": "Presidente do Banco do Brasil S.A;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "IX",
                                  "texto": "Presidente da Caixa Econômica Federal;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "X",
                                  "texto": "Presidente do Banco Nacional de Desenvolvimento Econômico e Social;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "XI",
                                  "texto": "Presidente da Comissão de Valores Mobiliários;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "XII",
                                  "texto": "Presidente do Banco da Amazônia S.A;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "XIII",
                                  "texto": "Presidente do Banco do Nordeste do Brasil S.A;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "XIV",
                                  "texto": "um representante das classes trabalhadoras, ouvidas as centrais sindicais, nomeado pelo Presidente da República;"
                                },
                                {
                                  "tipo": "inciso",
                                  "numero": "XV",
                                  "texto": "seis membros nomeados pelo Presidente da República entre brasileiros de ilibada reputação e notória capacidade em assuntos econômico-financeiros."
                                },
                                {
                                  "tipo": "paragrafo",
                                  "numero": "único",
                                  "texto": "Os membros referidos nos incisos XIV e XV terão mandato de dois anos, podendo ser reconduzidos."
                                }
                              ]
                            },
                            {
                              "tipo": "secao",
                              "numero": "",
                              "rubrica": "DAS REUNIÕES DO CONSELHO MONETÁRIO NACIONAL",
                              "texto": "",
                              "filhos": [
                                {
                                  "tipo": "subsecao",
                                  "numero": "",
                                  "rubrica": "DAS REUNIÕES DO CONSELHO MONETÁRIO NACIONAL",
                                  "texto": "",
                                  "filhos": [
                                    {
                                      "tipo": "artigo",
                                      "numero": "2º",
                                      "texto": "O Conselho deliberará mediante resoluções, por maioria de votos, com a presença de, no mínimo, onze membros, cabendo também ao Presidente o voto de qualidade e a prerrogativa de deliberar, nos casos de urgência e relevante interesse ad referendum do plenário."
                                    },
                                    {
                                      "tipo": "artigo",
                                      "numero": "3º",
                                      "texto": "Quando deliberar ad referendum do Conselho, o Presidente submeterá a decisão ao colegiado, na primeira reunião posterior à prática do ato."
                                    },
                                    {
                                      "tipo": "artigo",
                                      "numero": "4º",
                                      "texto": "Os diretores do Banco Central do Brasil participarão das reuniões do Conselho sem direito a voto."
                                    },
                                    {
                                      "tipo": "artigo",
                                      "numero": "5º",
                                      "texto": "O Presidente do Conselho poderá convidar outros Ministros de Estado, bem como representantes de entidades públicas ou privadas, para participar das reuniões, não lhes sendo permitido, porém, o direito de voto."
                                    },
                                    {
                                      "tipo": "artigo",
                                      "numero": "6º",
                                      "texto": "O Conselho reunir-se-á, ordinariamente, uma vez por mês, e, extraordinariamente, sempre que for convocado por seu Presidente ou a requerimento de, pelo menos, onze de seus membros."
                                    },
                                    {
                                      "tipo": "artigo",
                                      "numero": "7º",
                                      "texto": "De cada reunião do Conselho será lavrada a respectiva ata."
                                    },
                                    {
                                      "tipo": "artigo",
                                      "numero": "8º",
                                      "texto": "O Banco Central do Brasil funcionará como secretaria-executiva do Conselho."
                                    }
                                  ]
                                },
                                {
                                  "tipo": "artigo",
                                  "numero": "2º",
                                  "texto": "Esta lei entra em vigor na data de sua publicação."
                                },
                                {
                                  "tipo": "artigo",
                                  "numero": "3º",
                                  "texto": "Fica revogada a Lei nº 8.056, de 28 de junho de 1990."
                                }
                              ]
                            },
