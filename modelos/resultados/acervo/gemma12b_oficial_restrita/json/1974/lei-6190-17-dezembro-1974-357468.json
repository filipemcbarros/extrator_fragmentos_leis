      {
        "tipo": "artigo",
        "numero": "3º",
        "texto": "A Receita do Distrito Federal será realizada:",
        "filhos": [
          {
            "tipo": "inciso",
            "numero": "I",
            "texto": "pelo Tesouro, mediante arrecadação de tributos, fundos e outras Receitas Correntes e de Capital, de acordo com a legislação em vigor, relacionada no Anexo I, da presente Lei;"
          },
          {
            "tipo": "inciso",
            "numero": "II",
            "texto": "pelos Órgãos da Administração Indireta e Fundações, na forma prevista em seus respectivos Estatutos e/ou Regimentos;"
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "4º",
        "texto": "A despesa do Distrito Federal dividir-se-á em:",
        "filhos": [
