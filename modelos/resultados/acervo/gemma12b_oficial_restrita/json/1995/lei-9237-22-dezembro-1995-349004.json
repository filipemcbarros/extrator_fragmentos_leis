        {
          "tipo": "paragrafo",
          "numero": "único",
          "texto": "As vagas resultantes da execução desta Lei serão preenchidas mediante promoção ou admissão por concurso público, de acordo com a necessidade do serviço e as disponibilidades orçamentárias, na seguinte ordem:",
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "texto": "até dez por cento das vagas no primeiro ano;"
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "texto": "até vinte e cinco por cento das vagas no segundo ano;"
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "texto": "até quarenta por cento das vagas no terceiro ano;"
            },
            {
              "tipo": "inciso",
              "numero": "IV",
              "texto": "até sessenta por cento das vagas no quarto ano;"
            },
            {
              "tipo": "inciso",
              "numero": "V",
              "texto": "até oitenta por cento das vagas no quinto ano;"
            },
            {
              "tipo": "inciso",
              "numero": "VI",
              "texto": "até cem por cento das vagas no sexto ano."
            }
          ]
        }
      ]
