      {
        "tipo": "artigo",
        "numero": "2º",
        "texto": "O Quadro do Pessoal do Tribunal Superior do Trabalho passa a ser o constante da tabela, a que se refere o art. 6º desta lei.",
        "filhos": [
          {
            "tipo": "paragrafo",
            "numero": "único",
            "texto": "É alterada a denominação da carreira de Escriturário para Auxiliar Judiciário."
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "3º",
        "texto": "Os cargos de Chefe de Seção serão providos por funcionários do quadro do Tribunal."
      },
      {
        "tipo": "artigo",
        "numero": "4º",
        "texto": "É assegurada a situação pessoal dos atuais ocupantes de cargos em comissão, providos na forma do disposto art. 6º combinado com os arts. 4º e 10 da Lei nº 409, de 25 de setembro de 1948, inclusive quanto aos vencimentos fixados no art. 1º desta lei."
      },
