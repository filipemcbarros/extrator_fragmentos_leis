    {
      "tipo": "artigo",
      "numero": "3º",
      "texto": "Fazem parte integrante da presente lei os anexos que acompanham, especificando a Receita e discriminando as Despesas."
    },
    {
      "tipo": "artigo",
      "numero": "4º",
      "texto": "Fica o Prefeito expressamente autorizado a:",
      "filhos": [
        {
          "tipo": "inciso",
          "numero": "I",
          "texto": "realizar operações de crédito por antecipação da Receita até o limite de Cr$500.000.000,00 (quinhentos milhões de cruzeiros);"
        },
        {
          "tipo": "inciso",
          "numero": "II",
          "texto": "abrir os créditos suplementares e especiais que se fizerem necessários até 20% (vinte por cento) da Receita Tributária orçada, mediante Decreto e de acôrdo com o disposto no Decreto-lei Federal número 2.416, de 17 de julho de 1940;"
        },
        {
          "tipo": "inciso",
          "numero": "III",
          "texto": "firmar com a União convênio para a administração e cobrança dos tributos previstos na presente lei."
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "5º",
      "texto": "A Receita a que se refere a presente lei será arrecadada de acôrdo com a Lei 191, de 24 de dezembro de 1962 (Código Tributário do Distrito Federal)."
    },
    {
      "tipo": "artigo",
      "numero": "6º",
      "texto": "Esta lei entrará em vigor em 1º de janeiro de 1964, revogadas as disposições em contrário."
    }
