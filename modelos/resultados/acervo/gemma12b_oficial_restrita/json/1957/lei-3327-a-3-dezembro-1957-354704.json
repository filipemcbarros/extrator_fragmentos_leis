  {
    "continuacao": " Art. 5º As Divisões ou Serviços de Pessoal, Material, Orçamento e Obras dos Ministérios, inclusive a Diretoria da Despesa Pública do Ministério da Fazenda, sempre que necessário, movimentarão as dotações de pessoal, material de consumo, material permanente, serviços de terceiros, encargos diversos, obras e equipamentos discriminados nos Quadros Analíticos por unidades orçamentárias.",
    "titulo": "",
    "ementa": "",
    "preambulo": "",
    "fecho": "Rio de Janeiro, em 3 de dezembro de 1957; 136º da Independência e 69º da República. JUSCELINO KUBITSCHEK Eurico de Aguiar Salles Antônio Alves Câmara Henrique Lott José Carlos de Macedo Soares José Maria Alkmim Lucio Meira Mario Meneghetti Clóvis Salgado Parsifal Barroso Francisco de Melo Maurício de Medeiros",
    "dispositivos": [
      {
        "tipo": "artigo",
        "numero": "5º",
        "texto": "As Divisões ou Serviços de Pessoal, Material, Orçamento e Obras dos Ministérios, inclusive a Diretoria da Despesa Pública do Ministério da Fazenda, sempre que necessário, movimentarão as dotações de pessoal, material de consumo, material permanente, serviços de terceiros, encargos diversos, obras e equipamentos discriminados nos Quadros Analíticos por unidades orçamentárias.",
        "filhos": []
      },
      {
        "tipo": "artigo",
        "numero": "6º",
        "texto": "Fica o Poder Executivo autorizado a abrir os créditos suplementares que se fizerem necessários, na forma do art. 48 do regulamento geral de Contabilidade Pública, para atender às entregas das importâncias correspondentes às diferenças verificadas entre a receita efetivamente arrecadada e as dotações a ela vinculadas.",
        "filhos": []
      },
      {
        "tipo": "artigo",
        "numero": "7º",
        "texto": "O Poder Executivo fica autorizado, através do Ministério da Fazenda, a efetuar as operações de crédito, a médio prazo e juros não superiores a 10% ao ano, se necessárias à cobertura do <i>deficit</i>, no exercício de 1958.",
        "filhos": []
      },
      {
        "tipo": "artigo",
        "numero": "8º",
        "texto": "O Ministro de Estado da Fazenda fica autorizado a realizar as operações de crédito que se tornarem necessárias por antecipação da Receita, até 20% (vinte por cento) sôbre o montante da Despesa.",
        "filhos": []
      },
      {
        "tipo": "artigo",
        "numero": "9º",
        "texto": "VETADO.",
        "filhos": []
      },
      {
        "tipo": "artigo",
        "numero": "10",
        "texto": "Revogam-se as disposições em contrário.",
        "filhos": []
      }
    ]
  }
]