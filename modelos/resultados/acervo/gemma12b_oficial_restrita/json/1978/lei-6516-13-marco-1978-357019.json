              "texto": "",
              "filhos": [
                {
                  "tipo": "item",
                  "numero": "",
                  "texto": "Suboficiais e Sargentos das diversas especialidades do Corpo do Pessoal Graduado 17.000 "
                },
                {
                  "tipo": "item",
                  "numero": "",
                  "texto": "Cabos e Soldados de 1ª e 2ª Classes ........................................................................ 23.000 "
                },
                {
                  "tipo": "item",
                  "numero": "",
                  "texto": "Taifeiros das diferentes graduações ............................................................................ 3.700 "
                },
                {
                  "tipo": "item",
                  "numero": "",
                  "texto": "Voluntários das diferentes especialidades do Corpo do Pessoal Graduado .................. 1.000 "
                }
              ]
