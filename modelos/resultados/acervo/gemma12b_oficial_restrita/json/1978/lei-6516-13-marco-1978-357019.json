        {
          "tipo": "subsecao",
          "numero": "",
          "rubrica": "2 - PRAÇAS ESPECIAIS",
          "texto": "",
          "filhos": [
            {
              "tipo": "item",
              "numero": "",
              "texto": "Alunos da Academia da Força Aérea, Alunos de Curso de Formação de Oficiais e Alunos da Escola Preparatória de Cadetes do Ar ................................................................................................2.000 "
            },
            {
              "tipo": "item",
              "numero": "",
              "texto": "Alunos dos Centros de Preparação de Oficiais da Reserva ..................................... 200 "
            },
            {
              "tipo": "item",
              "numero": "",
              "texto": "Alunos da Escola de Especialistas da Aeronáutica ................................................2.200"
            },
            {
