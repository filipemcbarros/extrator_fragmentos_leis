        {
          "tipo": "artigo",
          "numero": "3º",
          "texto": "Não serão computados nos limites dos efetivos fixados no artigo 1º desta lei:",
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "texto": "os Bombeiros-Militares da reserva remunerada, designados para o serviço ativo;"
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "texto": "os Aspirantes-a-Oficial BM;"
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "texto": "os alunos dos Cursos de Formação de Oficiais ou de Graduados;"
            },
            {
              "tipo": "inciso",
              "numero": "IV",
              "texto": "os alunos do Curso de Formação de Soldados Bombeiros-Militares;"
            },
            {
              "tipo": "inciso",
              "numero": "V",
              "texto": "Os Bombeiros-Militares agregados e os que, por força da legislação anterior, permaneceram sem numeração nos Quadros de Origem."
            }
          ]
        },
        {
          "tipo": "artigo",
          "numero": "4º",
          "texto": "A fixação dos efetivos dos alunos dos Cursos de Formação de Bombeiros-Militares, em seus diversos círculos, será regulada pelo Comandante-Geral do Corpo de Bombeiros do Distrito Federal, de modo a atender às necessidades dos Postos e Graduações iniciais dos diversos Quadros."
        },
        {
          "tipo": "artigo",
          "numero": "5º",
          "texto": "As vagas resultantes da execução desta lei serão preenchidas no decurso de três anos, de acordo com as necessidades do serviço e a disponibilidade orçamentária, obedecidos os seguintes percentuais:",
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "texto": "40% (quarenta por cento), no ano de 1986;"
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "texto": "30% (trinta por cento), no ano de 1987;"
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "texto": "30% (trinta por cento), no ano de 1988."
            }
          ]
        },
        {
          "tipo": "artigo",
          "numero": "6º",
          "texto": "As despesas decorrentes da execução desta lei serão atendidas à conta das dotações consignadas ao Corpo de Bombeiros, constantes do Orçamento do Distrito Federal."
        },
        {
          "tipo": "artigo",
          "numero": "7º",
          "texto": "Esta lei entra em vigor na data de sua publicação."
        },
        {
          "tipo": "artigo",
          "numero": "8º",
          "texto": "Revogam-se as disposições em contrário, em especial a Lei nº 6.673, de 5 de julho de 1979."
        }
