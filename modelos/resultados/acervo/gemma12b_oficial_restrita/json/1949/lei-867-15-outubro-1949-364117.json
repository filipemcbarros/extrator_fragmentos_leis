  {
    "titulo": "LEI Nº 867, DE 15 DE OUTUBRO DE 1949",
    "ementa": "Estende ao Pessoal das Secretarias do Tribunal Superior Eleitoral e dos Tribunais Regionais Eleitorais dispositivos da Lei nº 488, de 15 de novembro de 1948.",
    "preambulo": "O PRESIDENTE DA REPÚBLICA Faço saber que o CONGRESSO NACIONAL decreta e eu sanciono a seguinte Lei:",
    "fecho": "",
    "dispositivos": [
      {
        "tipo": "artigo",
        "numero": "1º",
        "texto": "São extensivos aos funcionários das Secretarias do Tribunal Superior Eleitoral e dos Tribunais Regionais Eleitorais os valores dos padrões de vencimentos fixados pela Lei nº 488, de 15 de novembro de 1948.",
        "filhos": []
      },
