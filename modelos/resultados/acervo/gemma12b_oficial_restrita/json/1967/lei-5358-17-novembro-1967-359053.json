    {
      "tipo": "artigo",
      "numero": "4º",
      "texto": "A aplicação das dotações inscritas nos quadros mencionados no art. 3º, far-se-á mediante orçamentos analíticos organizados para cada anexo, ate 31 de dezembro do ano em curso.",
      "filhos": [
        {
          "tipo": "paragrafo",
          "numero": "1º",
          "texto": "Os orçamentos analíticos serão publicados obrigatòriamente no Diário Oficial da União e poderão ser alterados até 29 de outubro."
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "5º",
      "texto": "Fica o Prefeito do Distrito Federal autorizado a:",
      "filhos": [
        {
          "tipo": "inciso",
          "numero": "I",
          "texto": "Realizar operações de crédito por antecipação da receita até o limite de 50% (cinqüenta por cento) da Receita Tributária;"
        },
        {
          "tipo": "inciso",
          "numero": "II",
          "texto": "Abrir os créditos suplementares que se fizerem necessários, até o limite de 100% (cem por cento) da Receita Tributária orçada; mediante Decreto e de acôrdo com o disposto na Lei nº 4.320, de 17 de março de 1964;"
        },
        {
          "tipo": "inciso",
          "numero": "III",
          "texto": "Firmar convênio com a União para administração e cobrança dos tributos previstos na presente Lei."
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "6º",
      "texto": "A Receita a que se refere a presente Lei será arrecadada de acôrdo com o disposto no Decreto-lei nº 82, de 26 de dezembro de 1966 - Código Tributário do Distrito Federal."
    },
    {
      "tipo": "artigo",
      "numero": "7º",
      "texto": "As dotações de pessoal e material bem como as destinadas ao pagamento de água, luz e telefone, das diversas unidades orçamentárias poderão ser movimentadas pelos órgãos próprios da Secretaria de Administração do Distrito Federal, segundo o disposto no art. 66 da Lei nº 4.320, de 17 de março de 1964."
    },
    {
      "tipo": "artigo",
      "numero": "8º",
      "texto": "No decorrer do exercício, os recursos destinados aos Programas, Subprogramas e Metas poderão ser alterados, respeitado o total da Despesa por unidade orçamentária e obedecidos os limites máximos, para cada elemento da despesa."
    },
    {
      "tipo": "artigo",
      "numero": "9º",
      "texto": "Esta Lei entrará em vigor a 1º de janeiro de 1968, revogadas as disposições em contrário."
    }
  ]
