[
  {
    "titulo": "LEI Nº 1.386-A, DE 19 DE JUNHO DE 1951",
    "ementa": "Estende aos cargos isolados de provimento em comissão e às funções gratificadas do Quadro de Pessoal do Tribunal Superior do Trabalho os símbolos e valores estabelecidos na Lei n. 488, de 15 de novembro de 1948, e dá outras providências.",
    "preambulo": "O CONGRESSO NACIONAL decreta e eu, Alexandre Marcondes Filho, PRESIDENTE em exercício do SENADO FEDERAL, promulgo, nos têrmos do art. 70, § 4º, da Constituição Federal, a seguinte Lei:",
    "fecho": "",
    "dispositivos": [
      {
        "tipo": "artigo",
        "numero": "1º",
        "texto": "Os cargos isolados de provimento em comissão e as funções gratificadas do Quadro do Pessoal do Tribunal Superior do Trabalho correspondem aos seguintes símbolos e valores mensais:",
        "filhos": [
          {
            "tipo": "inciso",
            "numero": "CARGOS EM COMISSÃO",
            "texto": "",
            "filhos": [
