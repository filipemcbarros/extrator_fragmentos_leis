          {
            "tipo": "titulo",
            "numero": "PJ3",
            "texto": "11.000,00"
          },
          {
            "tipo": "titulo",
            "numero": "Funções Gratificadas",
            "texto": ""
          },
          {
            "tipo": "titulo",
            "numero": "FG3",
            "texto": "1.500,00"
          },
          {
            "tipo": "titulo",
            "numero": "FG4",
            "texto": "1.000,00"
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "2º",
        "texto": "O Quadro do Pessoal dos órgãos da Primeira Região da Justiça do Trabalho passa a ser o constante da Tabela anexa."
      },
      {
        "tipo": "artigo",
        "numero": "3º",
        "texto": "É alterada a denominação da carreira de Escriturário para Auxiliar Judiciário e a do cargo isolado de Oficial de Diligências para Oficial de Justiça."
      },
      {
        "tipo": "artigo",
        "numero": "4º",
        "texto": "São considerados extintos, no Quadro do Pessoal dos órgãos da Primeira Região da Justiça do Trabalho, os seguintes cargos:",
        "filhos": [
          {
            "tipo": "titulo",
            "numero": "1",
            "texto": "Taquígrafo"
          },
          {
            "tipo": "titulo",
            "numero": "H",
            "texto": ""
          },
          {
            "tipo": "titulo",
            "numero": "2",
            "texto": "Oficial Judiciário"
          },
          {
            "tipo": "titulo",
            "numero": "I",
            "texto": ""
          },
          {
            "tipo": "titulo",
            "numero": "3",
            "texto": "Oficial Judiciário"
          },
          {
            "tipo": "titulo",
            "numero": "H",
            "texto": ""
          },
          {
            "tipo": "titulo",
            "numero": "52",
            "texto": "Auxiliar Judiciário"
          },
          {
            "tipo": "titulo",
            "numero": "E",
            "texto": ""
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "5º",
        "texto": "São aproveitados nos mesmos cargos, que desempenhavam ou em seus equivalentes, os funcionários que se acham lotados ou em exercício no quadro do Pessoal do Tribunal Regional do Trabalho da Primeira Região."
      },
      {
        "tipo": "artigo",
        "numero": "6º",
        "texto": "São dispensadas da exigência de interstício as primeiras promoções para preenchimento dos cargos de carreira, constantes do quadro alterado por esta lei."
      },
      {
        "tipo": "artigo",
        "numero": "7º",
        "texto": "Esta lei entrará em vigor na data da sua publicação, revogadas as disposições em contrário."
      }
    ]
  },
