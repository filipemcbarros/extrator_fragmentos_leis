  {
    "titulo": "",
    "ementa": "",
    "preambulo": "",
    "fecho": "Rio de Janeiro, em 11 de junho de 1958; 137º da Independência e 70º da República. JUSCELINO KUBITSCHEK Antonio Alves Câmara",
    "dispositivos": [
      {
        "tipo": "artigo",
        "numero": "1",
        "texto": "VETADO.",
        "filhos": [
          {
            "tipo": "paragrafo",
            "numero": "1",
            "texto": "O preenchimento das vagas, em janeiro de 1959, far-se-á de acôrdo com as quotas de merecimento e antiguidade previstas no Regulamento de Promoções em vigor."
          },
          {
            "tipo": "paragrafo",
            "numero": "2",
            "texto": "Os oficiais agregados e que forem promovidos na forma do parágrafo anterior, deixarão essa situação e passarão a ocupar o número que lhes couber na escala respectiva, que estejam em função de caráter militar."
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "3",
        "texto": "Continuam em vigor as disposições do art. 5º e seus §§ 1º, 2º, 6º, 7º, 8º, 9º e 10 da Lei número 1.531-A de 29 de dezembro de 1951."
      },
      {
        "tipo": "artigo",
        "numero": "4",
        "texto": "O ingresso nos Quadros do Corpo de Saúde da Marinha far-se-á no pôsto de Primeiro Tenente."
      },
      {
        "tipo": "artigo",
        "numero": "5",
        "texto": "Os atuais Segundos Tenentes dos Quadros de Cirurgiões Dentistas e Farmacêuticos, em virtude da presente lei, serão promovidos ao pôsto de Primeiros Tenentes, independente de interstício e vagas. E contarão antiguidade de acôrdo com a Lei nº 2.999, de 11 de dezembro de 1956, sem direito a vencimentos e vantagens atrasados."
      },
      {
        "tipo": "artigo",
        "numero": "6",
        "texto": "VETADO."
      },
      {
        "tipo": "artigo",
        "numero": "7",
        "texto": "Esta lei entrará em vigor na data de sua publicação, revogadas as disposições em contrário."
      }
    ]
  }
]