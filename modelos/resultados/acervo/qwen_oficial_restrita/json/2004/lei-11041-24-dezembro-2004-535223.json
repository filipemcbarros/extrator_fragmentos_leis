[
  {
    "titulo": "LEI Nº 11.041, DE 24 DE DEZEMBRO DE 2004",
    "ementa": "Abre ao Orçamento Fiscal da União, em favor do Ministério dos Transportes, crédito especial no valor de R$ 35.000.000,00, para os fins que especifica.",
    "preambulo": "O PRESIDENTE DA REPÚBLICA\nFaço saber que o Congresso Nacional decreta e eu sanciono a seguinte Lei:",
    "fecho": "",
    "dispositivos": [
      {
        "tipo": "artigo",
        "numero": "1º",
        "texto": "Fica aberto ao Orçamento Fiscal da União (Lei n° 10.837, de 16 de janeiro de 2004), em favor do Ministério dos Transportes, crédito especial no valor de R$ 35.000.000,00 (trinta e cinco milhões de reais), para atender às programações constantes do Anexo desta Lei."
      },
      {
        "tipo": "artigo",
        "numero": "2º",
        "texto": "Os recursos necessários à abertura do crédito de que trata o art. 1º decorrem de excesso de arrecadação de Recursos Ordinários."
      },
      {
        "tipo": "artigo",
        "numero": "3º",
        "texto": "Esta Lei entra em vigor na data de sua publicação."
      }
    ]
  },
