    {
      "tipo": "artigo",
      "numero": "3º",
      "texto": "Fazem parte integrante da presente lei os anexos que a acompanham especificando a Receita e discriminando as Despesas."
    },
    {
      "tipo": "artigo",
      "numero": "4º",
      "texto": "Fica o Prefeito expressamente autorizado a:",
      "filhos": [
        {
          "tipo": "inciso",
          "numero": "I",
          "texto": "Realizar operações de crédito por antecipação da Receita até o limite de Cr$200.000.000,00 (duzentos milhões de cruzeiros).",
          "filhos": [
            {
              "tipo": "alinea",
              "numero": "a",
              "texto": "I -"
            }
          ]
        },
        {
          "tipo": "inciso",
          "numero": "II",
          "texto": "Abrir os créditos suplementares que se fizerem necessários até 20% (vinte por cento) da Receita Tributária orçada e até o máximo de 100% (cem por cento) da dotação, mediante Decreto e de acôrdo com o disposto na Decreto-lei Federal nº 2.416, de 17 de julho de 1940.",
          "filhos": [
            {
              "tipo": "alinea",
              "numero": "a",
              "texto": "II -"
            },
            {
              "tipo": "alinea",
              "numero": "b",
              "texto": "II -"
            },
            {
              "tipo": "alinea",
              "numero": "c",
              "texto": "III -"
            }
          ]
        },
        {
          "tipo": "inciso",
          "numero": "III",
          "texto": "Firmar com a União convênio para administração de cobrança dos tributos previstos na presente lei.",
          "filhos": [
            {
              "tipo": "alinea",
              "numero": "a",
              "texto": "III -"
            }
          ]
        },
        {
          "tipo": "paragrafo",
          "numero": "único",
          "texto": "A Receita a que se refere a presente lei será arrecadada de acôrdo com a legislação tributária em vigor no Distrito Federal."
        },
        {
          "tipo": "artigo",
          "numero": "5º",
          "texto": "Esta lei entrará em vigor em 1º de janeiro de 1963, revogadas as disposições em contrário."
        }
      ]
