              }
            ]
          },
          {
            "tipo": "paragrafo",
            "numero": "único",
            "texto": "O registro é gratuito."
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "11",
        "texto": "Esta Lei entrará em vigor na data de sua publicação, revogadas as disposições em contrário.",
