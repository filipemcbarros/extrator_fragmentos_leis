{
  "titulo": "LEI Nº 13.008, DE 26 DE JUNHO DE 2014",
  "ementa": "Dá nova redação ao art. 334 do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 - Código Penal e acrescenta-lhe o art. 334-A.",
  "preambulo": " A PRESIDENTA DA REPÚBLICA  Faço saber que o Congresso Nacional decreta e eu sanciono a seguinte Lei: ",
  "fecho": "Brasília, 26 de junho de 2014; 193º da Independência e 126º da República. DILMA ROUSSEFF José Eduardo Cardozo",
  "dispositivos": [
    {
      "tipo": "artigo",
      "numero": "1º",
      "texto": "O Decreto-Lei nº 2.848, de 7 de dezembro de 1940 - Código Penal, passa a vigorar com as seguintes alterações: ",
      "filhos": [
        {
          "tipo": "inciso",
          "numero": "I",
          "texto": "Descaminho ",
          "filhos": [
            {
              "tipo": "alinea",
              "numero": "a",
              "texto": ""
            },
            {
              "tipo": "alinea",
              "numero": "b",
              "texto": ""
            }
          ]
        },
        {
          "tipo": "inciso",
          "numero": "II",
          "texto": "Contrabando ",
          "filhos": [
            {
              "tipo": "alinea",
              "numero": "a",
              "texto": ""
            },
            {
              "tipo": "alinea",
              "numero": "b",
              "texto": ""
            }
          ]
        },
        {
          "tipo": "paragrafo",
          "numero": "1º",
          "texto": "Iludir, no todo ou em parte, o pagamento de direito ou imposto devido pela entrada, pela saída ou pelo consumo de mercadoria: ",
          "filhos": [
            {
              "tipo": "inciso",
              "numero": "I",
              "texto": "pratica navegação de cabotagem, fora dos casos permitidos em lei; ",
              "filhos": [
                {
                  "tipo": "alinea",
                  "numero": "a",
                  "texto": ""
                },
                {
                  "tipo": "alinea",
                  "numero": "b",
                  "texto": ""
                }
              ]
            },
            {
              "tipo": "inciso",
              "numero": "II",
              "texto": "pratica fato assimilado, em lei especial, a descaminho; ",
              "filhos": [
                {
                  "tipo": "alinea",
                  "numero": "a",
                  "texto": ""
                },
                {
                  "tipo": "alinea",
                  "numero": "b",
                  "texto": ""
                }
              ]
            },
            {
              "tipo": "inciso",
              "numero": "III",
              "texto": "vende, expõe à venda, mantém em depósito ou, de qualquer forma, utiliza em proveito próprio ou alheio, no exercício de atividade comercial ou industrial, mercadoria de procedência estrangeira que introduziu clandestinamente no País ou importou fraudulentamente ou que sabe ser produto de introdução clandestina no território nacional ou de importação fraudulenta por parte de outrem; ",
              "filhos": [
                {
                  "tipo": "alinea",
                  "numero": "a",
                  "texto": ""
                },
                {
                  "tipo": "alinea",
                  "numero": "b",
                  "texto": ""
                }
              ]
            },
            {
              "tipo": "inciso",
              "numero": "IV",
              "texto": "adquire, recebe ou oculta, em proveito próprio ou alheio, no exercício de atividade comercial ou industrial, mercadoria de procedência estrangeira, desacompanhada de documentação legal ou acompanhada de documentos que sabe serem falsos. ",
              "filhos": [
                {
                  "tipo": "alinea",
                  "numero": "a",
                  "texto": ""
                },
                {
                  "tipo": "alinea",
                  "numero": "b",
                  "texto": ""
                }
              ]
            },
            {
              "tipo": "paragrafo",
              "numero": "2º",
              "texto": "Equipara-se às atividades comerciais, para os efeitos deste artigo, qualquer forma de comércio irregular ou clandestino de mercadorias estrangeiras, inclusive o exercido em residências. ",
              "filhos": [
                {
                  "tipo": "alinea",
                  "numero": "a",
                  "texto": ""
                },
                {
                  "tipo": "alinea",
                  "numero": "b",
                  "texto": ""
                }
              ]
            },
            {
              "tipo": "paragrafo",
              "numero": "3º",
              "texto": "A pena aplica-se em dobro se o crime de descaminho é praticado em transporte aéreo, marítimo ou fluvial."
            },
            {
              "tipo": "inciso",
              "numero": "V",
              "texto": "Importar ou exportar mercadoria proibida: ",
              "filhos": [
                {
                  "tipo": "alinea",
                  "numero": "a",
                  "texto": ""
                },
                {
                  "tipo": "alinea",
                  "numero": "b",
                  "texto": ""
                }
              ]
            },
            {
              "tipo": "paragrafo",
              "numero": "1º",
              "texto": "Incorre na mesma pena quem: ",
              "filhos": [
                {
                  "tipo": "inciso",
                  "numero": "I",
                  "texto": "pratica fato assimilado, em lei especial, a contrabando; ",
                  "filhos": [
                    {
                      "tipo": "alinea",
                      "numero": "a",
                      "texto": ""
                    },
                    {
                      "tipo": "alinea",
                      "numero": "b",
                      "texto": ""
                    }
                  ]
                },
                {
                  "tipo": "inciso",
                  "numero": "II",
                  "texto": "importa ou exporta clandestinamente mercadoria que dependa de registro, análise ou autorização de órgão público competente; ",
                  "filhos": [
                    {
                      "tipo": "alinea",
                      "numero": "a",
                      "texto": ""
                    },
                    {
                      "tipo": "alinea",
                      "numero": "b",
                      "texto": ""
                    }
                  ]
                },
                {
                  "tipo": "inciso",
                  "numero": "III",
                  "texto": "reinsere no território nacional mercadoria brasileira destinada à exportação; ",
                  "filhos": [
                    {
                      "tipo": "alinea",
                      "numero": "a",
                      "texto": ""
                    },
                    {
                      "tipo": "alinea",
                      "numero": "b",
                      "texto": ""
                    }
                  ]
                },
                {
                  "tipo": "inciso",
                  "numero": "IV",
                  "texto": "vende, expõe à venda, mantém em depósito ou, de qualquer forma, utiliza em proveito próprio ou alheio, no exercício de atividade comercial ou industrial, mercadoria proibida pela lei brasileira; ",
                  "filhos": [
                    {
                      "tipo": "alinea",
                      "numero": "a",
                      "texto": ""
                    },
                    {
                      "tipo": "alinea",
                      "numero": "b",
                      "texto": ""
                    }
                  ]
                },
                {
                  "tipo": "inciso",
                  "numero": "V",
                  "texto": "adquire, recebe ou oculta, em proveito próprio ou alheio, no exercício de atividade comercial ou industrial, mercadoria proibida pela lei brasileira. ",
                  "filhos": [
                    {
                      "tipo": "alinea",
                      "numero": "a",
                      "texto": ""
                    },
                    {
                      "tipo": "alinea",
                      "numero": "b",
                      "texto": ""
                    }
                  ]
                },
                {
                  "tipo": "paragrafo",
                  "numero": "2º",
                  "texto": "Equipara-se às atividades comerciais, para os efeitos deste artigo, qualquer forma de comércio irregular ou clandestino de mercadorias estrangeiras, inclusive o exercido em residências. ",
                  "filhos": [
                    {
                      "tipo": "alinea",
                      "numero": "a",
                      "texto": ""
                    },
                    {
                      "tipo": "alinea",
                      "numero": "b",
                      "texto": ""
                    }
                  ]
                },
                {
                  "tipo": "paragrafo",
                  "numero": "3º",
                  "texto": "A pena aplica-se em dobro se o crime de contrabando é praticado em transporte aéreo, marítimo ou fluvial."
                }
              ]
            },
            {
              "tipo": "artigo",
              "numero": "2º",
              "texto": "Esta Lei entra em vigor na data de sua publicação."
            }
          ]
        }
      ]
    }
  ]
}