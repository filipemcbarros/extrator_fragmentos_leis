        },
        {
          "tipo": "item",
          "numero": "10.",
          "texto": "Total................................................................................................................................................... 15.000.000"
        }
      ]
    },
    {
      "tipo": "artigo",
      "numero": "2º",
      "texto": "O pagamento dos auxílios concedidos no artigo anterior será feito diretamente ás Prefeituras Municipais."
    },
