            {
              "tipo": "artigo",
              "numero": "2º",
              "texto": "É aberto ao Poder Judiciário - Tribunal Regional do Trabalho da 1ª Região - o crédito especial de Cr$ 4.248.800,00 (quatro milhões, duzentos e quarenta e oito mil e oitocentos cruzeiros) para atender ao pagamento, no exercício de 1956, de vencimentos e salários-família a funcionários daquele Tribunal."
            },
            {
              "tipo": "artigo",
              "numero": "3º",
              "texto": "É também aberto ao Poder Judiciário - Tribunal Regional do Trabalho da 1ª Região - o crédito especial de Cr$ 2.000.000,00 (dois milhões de cruzeiros) destinado a atender, no exercício de 1956, a despesas com aquisição de mobiliário, máquinas, motores e aparelhos, limpeza, adaptação e conservação de bens imóveis."
            },
            {
              "tipo": "artigo",
              "numero": "4º",
              "texto": "Os créditos especiais de que tratam os artigos anteriores serão automàticamente registrados pelo Tribunal de Contas e distribuídos ao Tesouro Nacional."
            },
            {
              "tipo": "artigo",
              "numero": "5º",
              "texto": "Esta lei entrará em vigor na data de sua publicação, revogadas as disposições em contrário."
            }
          ]
