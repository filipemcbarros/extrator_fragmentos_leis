        {
          "tipo": "artigo",
          "numero": "2º",
          "texto": "Fica autorizada a cobrança do impôsto único, criado pelo Decreto-lei nº 2.615, de 21 de setembro de 1940, modificado pelas Leis números 1.749, de 28 de novembro de 1952, e 2.975, de 27 de novembro de 1956, cujo produto será aplicado de acôrdo com o que estabelece a legislação vigente.",
          "filhos": [
            {
              "tipo": "paragrafo",
              "numero": "único",
              "texto": "O recolhimento do impôsto único a que se refere êste artigo continuará a processar-se de acôrdo com o estabelecido no artigo 4º da Lei nº 4.452, de 5 de novembro de 1964."
            }
          ]
        },
        {
