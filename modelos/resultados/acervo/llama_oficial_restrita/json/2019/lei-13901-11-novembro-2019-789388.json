      {
        "tipo": "artigo",
        "numero": "1º",
        "texto": "A Lei nº 13.844, de 18 de junho de 2019, passa a vigorar com as seguintes alterações:",
        "filhos": [
          {
            "tipo": "inciso",
            "numero": "I",
            "texto": "............................................................................................................................"
          },
          {
            "tipo": "inciso",
            "numero": "II",
            "texto": "para as de transporte:",
            "filhos": [
              {
                "tipo": "alinea",
