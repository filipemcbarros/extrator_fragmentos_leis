      {
        "tipo": "inciso",
        "numero": "IX",
        "texto": "harmonizar as políticas nacionais de transporte com as políticas de transporte dos Estados, do Distrito Federal e dos Municípios, com vistas à articulação dos órgãos encarregados do gerenciamento dos sistemas viários e da regulação dos transportes interestaduais, intermunicipais e urbanos;",
        "filhos": [
          {
            "tipo": "inciso",
