[
  {
    "epigrafe": "LEI Nº 11.518, DE 5 DE SETEMBRO DE 2007",
    "ementa": "Acresce e altera dispositivos das Leis nºs 10.683, de 28 de maio de 2003, 10.233, de 5 de junho de 2001, 10.893, de 13 de julho de 2004, 5.917, de 10 de setembro de 1973, 11.457, de 16 de março de 2007, e 8.630, de 25 de fevereiro de 1993, para criar a Secretaria Especial de Portos, e dá outras providências.",
    "preambulo": "O PRESIDENTE DA REPÚBLICA Faço saber que o Congresso Nacional decreta e eu sanciono a seguinte Lei:",
    "fecho": "",
    "dispositivos": [
      {
        "tipo": "artigo",
        "numero": "1º",
        "texto": "O § 3º do art. 1º da Lei nº 10.683, de 28 de maio de 2003, passa a vigorar acrescido do seguinte inciso VII:",
        "filhos": [
          {
            "tipo": "inciso",
            "numero": "VII",
            "texto": "a Secretaria Especial de Portos."
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "2º",
        "texto": "As alíneas b e c do inciso XXII do caput do art. 27 da Lei nº 10.683, de 28 de maio de 2003, passam a vigorar com a seguinte redação:",
        "filhos": [
          {
            "tipo": "alinea",
            "numero": "b",
            "texto": "marinha mercante, vias navegáveis e portos fluviais e lacustres, excetuados os outorgados às companhias docas;"
          },
          {
            "tipo": "alinea",
            "numero": "c",
            "texto": "participação na coordenação dos transportes aeroviários e serviços portuários;"
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "3º",
        "texto": "A Seção II do Capítulo I da Lei nº 10.683, de 28 de maio de 2003, passa a vigorar acrescida do seguinte art. 24-A:",
        "filhos": [
          {
            "tipo": "artigo",
            "numero": "24-A",
            "texto": "À Secretaria Especial de Portos compete assessorar direta e imediatamente o Presidente da República na formulação de políticas e diretrizes para o desenvolvimento e o fomento do setor de portos e terminais portuários marítimos e, especialmente, promover a execução e a avaliação de medidas, programas e projetos de apoio ao desenvolvimento da infra-estrutura e da superestrutura dos portos e terminais portuários marítimos, bem como dos outorgados às companhias docas.",
            "filhos": [
              {
                "tipo": "paragrafo",
                "numero": "1º",
                "texto": "A Secretaria Especial de Portos tem como estrutura básica o Gabinete, o Instituto Nacional de Pesquisas Hidroviárias - INPH e até 2 (duas) Subsecretarias."
              },
              {
                "tipo": "paragrafo",
                "numero": "2º",
                "texto": "As competências atribuídas no caput deste artigo à Secretaria Especial de Portos compreendem:",
                "filhos": [
                  {
                    "tipo": "item",
                    "numero": "I",
                    "texto": "a formulação, coordenação e supervisão das políticas nacionais;"
                  },
                  {
                    "tipo": "item",
                    "numero": "II",
                    "texto": "a participação no planejamento estratégico, o estabelecimento de diretrizes para sua implementação e a definição das prioridades dos programas de investimentos;"
                  },
                  {
                    "tipo": "item",
                    "numero": "III",
                    "texto": "a aprovação dos planos de outorgas;"
                  },
                  {
                    "tipo": "item",
                    "numero": "IV",
                    "texto": "o estabelecimento de diretrizes para a representação do Brasil nos organismos internacionais e em convenções, acordos e tratados referentes às competências mencionadas no caput deste artigo; e"
                  },
                  {
                    "tipo": "item",
                    "numero": "V",
                    "texto": "o desenvolvimento da infra-estrutura e da superestrutura aquaviária dos portos e terminais portuários sob sua esfera de atuação, visando à segurança e à eficiência do transporte aquaviário de cargas e de passageiros."
                  },
                  {
                    "tipo": "paragrafo",
                    "numero": "3º",
                    "texto": "No exercício das competências previstas no caput deste artigo, a Secretaria Especial de Portos observará as prerrogativas específicas do Comando da Marinha."
                  },
                  {
                    "tipo": "paragrafo",
                    "numero": "4º",
                    "texto": "(VETADO)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "4º",
        "texto": "A Lei nº 10.233, de 5 de junho de 2001, passa a vigorar com a seguinte redação:",
        "filhos": [
          {
            "tipo": "artigo",
            "numero": "5",
            "texto": "(NR)"
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "5º",
        "texto": "A Lei nº 10.233, de 5 de junho de 2001, passa a vigorar com a seguinte redação:",
        "filhos": [
          {
            "tipo": "artigo",
            "numero": "6",
            "texto": "(NR)"
          }
        ]
      },
      {
        "tipo": "artigo",
        "numero": "6º",
        "texto": "Fica criada a Secretaria Especial de Portos da Presidência da República.",
        "filhos": [
          {
            "tipo": "paragrafo",
            "numero": "único",
            "texto": "Ficam transferidas para a Secretaria Especial de Portos da Presidência da República e a seu titular as competências atribuídas ao Ministério dos Transportes e ao Departamento Nacional de Infra-Estrutura de Transportes - DNIT, em leis gerais ou específicas, relativas a:",
            "filhos": [
              {
                "tipo": "item",
                "numero": "I",
                "texto": "portos marítimos;"
              },
              {
                "tipo": "item",
                "numero": "II",
                "texto": "(VETADO)"
              },
              {
                "tipo": "item",
                "numero": "III",
                "texto": "portos outorgados e delegados às companhias docas;"
              },
              {
                "tipo": "item",
                "numero": "IV",
                "texto": "(VETADO)"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "epigrafe": "",
